# Copy to VIBSL dashboard → Settings → Environment Variables (do not commit real secrets)
HOST=0.0.0.0
PORT=8080
API_TOKEN=dev-token

# Optional: path to kubeconfig inside the container for POST /deploy
# KUBECONFIG_PATH=/secrets/kubeconfig

# Optional: read token from a mounted secret file instead of API_TOKEN
# API_TOKEN_FILE=/secrets/api_token
